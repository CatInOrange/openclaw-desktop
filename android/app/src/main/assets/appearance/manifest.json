{
  "manifest_version": 2,
  "name": "OpenClaw local appearance",
  "version": "0.2.2",
  "browser_specific_settings": {
    "gecko": {
      "id": "appearance@openclaw.mobile"
    }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "pet-observer.js",
        "pet-main.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "background-core.js",
        "appearance.js",
        "pet-state.js",
        "pet-mobile.js"
      ],
      "css": [
        "background.css"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "background": {
    "scripts": [
      "background-media.js",
      "media-service.js",
      "pet-media.js"
    ],
    "persistent": true
  }
}
